Q1 — 8-puzzle using A* algorithm (Manhattan heuristic)
import heapq
def manhattan(state, goal):
    dist=0     for i,val in enumerate(state):
        if val==0: continue         j=goal.index(val)         dist += abs(i//3 - j//3) + abs(i%3 - j%3)     return dist
def astar(start, goal):
    start=tuple(start); goal=tuple(goal)     openp=[(manhattan(start,list(goal)),0,start, None)]     heapq.heapify(openp)     g={start:0}     parent={start:None}     while openp:
        f,gcost,state,_ = heapq.heappop(openp)         if state==goal:
            path=[]; cur=state             while cur:
                path.append(list(cur))                 cur=parent[cur]             return list(reversed(path))         zero = state.index(0)         x,y = zero//3, zero%3         moves=[]         for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
            nx,ny = x+dx, y+dy             if 0<=nx<3 and 0<=ny<3:                 lst=list(state)                 idx=nx*3+ny                 lst[zero], lst[idx] = lst[idx], lst[zero]                 moves.append(tuple(lst))         for m in moves:             ng = gcost+1             if m not in g or ng < g[m]:
                g[m]=ng                 parent[m]=state                 heapq.heappush(openp,(ng+manhattan(m,list(goal)),ng,m,None))     return None
if __name__=="__main__":
    start = [1,2,3,4,0,6,7,5,8]     goal = [1,2,3,4,5,6,7,8,0]     path = astar(start, goal)     print("Steps:", len(path)-1)     for p in path:
        print(p[0:3]); print(p[3:6]); print(p[6:9]); print() Note: A* with Manhattan distance heuristic.
