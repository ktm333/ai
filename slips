# Hill Climbing for f(x) = -x^2 + 4x import random
def f(x): return -x*x + 4*x
def hill_climb(start=None, step=0.1, iters=1000):     if start is None:
        x = random.uniform(-10,10)     else:
        x = start     for i in range(iters):         left = f(x - step)         right = f(x + step)         current = f(x)         if left > current:
            x -= step         elif right > current:
            x += step         else:             break     return x, f(x)
